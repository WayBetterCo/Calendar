# Use a Google OAuth Desktop app client, not a Web application client.
WAYBETTER_GOOGLE_CLIENT_ID=
# Optional compatibility setting for private local development. Never packaged.
WAYBETTER_GOOGLE_CLIENT_SECRET=
# Desktop loopback callback: http://localhost:53682/oauth/google/callback
WAYBETTER_GOOGLE_REDIRECT_PORT=53682

WAYBETTER_MICROSOFT_CLIENT_ID=
# Register as a public desktop client in Entra, without a client secret.
# Callback: http://localhost:53685/oauth/microsoft/callback
WAYBETTER_MICROSOFT_REDIRECT_PORT=53685

# Optional Zoom integration uses your own local OAuth registration only.
# Never place the Zoom secret in resources/release.env or public builds.
WAYBETTER_ZOOM_CLIENT_ID=
WAYBETTER_ZOOM_CLIENT_SECRET=
# Optional, useful because Zoom redirect URLs are usually exact.
# Register http://localhost:53683/oauth/zoom/callback in Zoom Marketplace.
WAYBETTER_ZOOM_REDIRECT_PORT=53683

# Used only for creating standalone Teams meeting links.
WAYBETTER_TEAMS_CLIENT_ID=
# Requires an eligible work or school Teams account and tenant consent.
# Register http://localhost:53684/oauth/teams/callback as a public desktop redirect in Entra.
WAYBETTER_TEAMS_REDIRECT_PORT=53684
