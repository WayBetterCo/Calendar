# Public OAuth configuration packaged into release builds.
# Client IDs are public identifiers. Do not put credential values or JSON in this file.
# Google must be registered as a Desktop app client with the intended consent audience.
# Its nonconfidential Desktop client value is supplied separately through packaging
# env WAYBETTER_GOOGLE_DESKTOP_CREDENTIALS (Actions secret GOOGLE_DESKTOP_OAUTH_JSON).
# https://developers.google.com/identity/protocols/oauth2/#installed
WAYBETTER_GOOGLE_CLIENT_ID=690043002085-pg1f0eankh02i970ogq98sqolulf5u7n.apps.googleusercontent.com
WAYBETTER_GOOGLE_REDIRECT_PORT=53682
# WAYBETTER_MICROSOFT_CLIENT_ID=
WAYBETTER_MICROSOFT_REDIRECT_PORT=53685
# Optional standalone Teams integration. Requires a public desktop Entra registration.
# WAYBETTER_TEAMS_CLIENT_ID=
WAYBETTER_TEAMS_REDIRECT_PORT=53684
