{
  "name": "waybetter-calendar",
  "productName": "WayBetter Calendar",
  "version": "1.1.4",
  "description": "A slim desktop calendar app.",
  "homepage": "https://www.thewaybetter.co",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --mac --dir --publish never",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run check && npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run check && npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run check && npm run build && electron-builder --linux --x64 --publish never",
    "prepare:release-env": "node scripts/write-release-env.mjs",
    "install:local": "node scripts/install-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "dist:mac:arm64": "npm run check && npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run check && npm run build && electron-builder --mac --x64 --publish never"
  },
  "keywords": [
    "calendar",
    "electron",
    "agenda"
  ],
  "author": "WayBetter <hello@thewaybetter.co>",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.waybetter.calendar",
    "productName": "WayBetter Calendar",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "artifactName": "WayBetter-Calendar-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "resources/.env",
      "resources/waybetter-calendar-icon.png",
      "resources/waybetter-calendar-icon.icns",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/waybetter-calendar-icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/waybetter-calendar-icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "WayBetter <hello@thewaybetter.co>",
      "icon": "resources/waybetter-calendar-icon.png",
      "target": [
        "AppImage"
      ]
    },
    "beforePack": "./scripts/before-pack.cjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": {
        "global-agent": "^4.1.3"
      }
    }
  }
}
